# ==========================================
# 1. DATABASE CONFIGURATION (PostgreSQL / Cloud SQL)
# ==========================================
# For Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hairstudio?sslmode=disable"
#
# For Google Cloud SQL (Public IP with SSL):
# DATABASE_URL="postgresql://dbuser:strongpassword@34.123.45.67:5432/hairstudio?sslmode=require"
#
# For Google Cloud SQL (via Cloud SQL Auth Proxy on Cloud Run / Unix Socket):
# DATABASE_URL="postgresql://dbuser:strongpassword@/hairstudio?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME"
#
# For Serverless Postgres (Neon / Supabase):
# DATABASE_URL="postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hairstudio?sslmode=disable"

# ==========================================
# 2. GOOGLE GENAI CONFIGURATION (Gemini 2.5 Flash / Pro)
# ==========================================
# Option A: Gemini Developer API Key (Google AI Studio)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Option B: Google Cloud Vertex AI (Default for Cloud Run with Service Account)
# Set to 'true' if calling Gemini via Vertex AI in your Google Cloud Project
GOOGLE_GENAI_USE_VERTEX="false"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"

# ==========================================
# 3. SERVER & CLOUD RUN RUNTIME
# ==========================================
PORT=3000
NODE_ENV="production"
